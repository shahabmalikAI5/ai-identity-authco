# Neon Postgres connection string (e.g. postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# This identity server's own public URL (the issuer)
BETTER_AUTH_URL=http://localhost:3000

# The resource server's canonical URL — the audience for tokens it validates (used by spec 05)
RESOURCE_URL=http://localhost:8000

# Google OAuth credentials (projects/social-login). Client ID + secret from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Test seam for the social-login acceptance harness. NEVER set in production.
GOOGLE_TEST_MODE=

# Enable the proof-of-presence (WebAuthn) step-up gate (projects/step-up-approval).
# Off by default: with it on, approving a pending agent on a pending host demands
# WebAuthn for every capability, which changes the on-behalf-of flow. Acceptance
# harness for step-up-approval boots the server with STEP_UP_PROOF_OF_PRESENCE=true.
STEP_UP_PROOF_OF_PRESENCE=
# Optional WebAuthn Relying Party ID (defaults to the baseURL host). Needs a
# registered passkey to complete a step-up approval; the guardrail test passes
# without one (approval is refused with webauthn_not_enrolled).
STEP_UP_RP_ID=
