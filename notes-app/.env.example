# Notes app — OAuth client. It verifies AuthCo tokens offline via JWKS and holds
# no access to AuthCo's database. Get CLIENT_ID / CLIENT_SECRET from AuthCo's
# client registration (spec 04).
CLIENT_ID=
CLIENT_SECRET=

# AuthCo identity provider
AUTHCO_URL=http://localhost:3000
AUTHCO_JWKS_URL=http://localhost:3000/api/auth/jwks

# Secret used to sign the Notes app's own session cookie. Generate with: openssl rand -base64 32
NOTES_SECRET=

# Express port
PORT=3001
